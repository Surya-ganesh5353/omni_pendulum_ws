<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="omni_pendulum">

  <xacro:property name="wheel_xoff" value="0.15"/>
  <xacro:property name="wheel_yoff" value="0.18"/>

  <!-- Base Chassis Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.08"/>
    </inertial>
    <visual>
      <geometry><box size="0.4 0.3 0.08"/></geometry>
      <material name="chassis_mat"><color rgba="0.15 0.15 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.38 0.28 0.08"/></geometry>
    </collision>
  </link>

  <!-- Mecanum Wheel Macro -->
  <xacro:macro name="mecanum_wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
      </inertial>
      <visual>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
        <material name="wheel_mat"><color rgba="0.8 0.4 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_reflect * wheel_xoff} ${y_reflect * wheel_yoff} 0" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:mecanum_wheel prefix="front_left" x_reflect="1" y_reflect="1"/>
  <xacro:mecanum_wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>
  <xacro:mecanum_wheel prefix="rear_left" x_reflect="-1" y_reflect="1"/>
  <xacro:mecanum_wheel prefix="rear_right" x_reflect="-1" y_reflect="-1"/>

  <!-- Pitch Joint -->
  <joint name="pendulum_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="dummy_pitch_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="10.0"/>
    <dynamics damping="0.0001" friction="0.0"/>
  </joint>

  <link name="dummy_pitch_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Roll Joint & Pendulum -->
  <joint name="pendulum_roll_joint" type="revolute">
    <parent link="dummy_pitch_link"/>
    <child link="pendulum_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="10.0"/>
    <dynamics damping="0.0001" friction="0.0"/>
  </joint>

  <link name="pendulum_link">
    <inertial>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.4"/></geometry>
      <material name="pendulum_mat"><color rgba="0.9 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.4"/></geometry>
    </collision>
  </link>

  <!-- Gazebo Mecanum Drive Plugin -->
  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>0.36</wheel_separation>
      <wheel_base>0.3</wheel_base>
      <wheel_radius>0.05</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>
</robot>ros2 topic pub /cmd_vel geometry_msgs/msg/Twist "{linear: {x: 0.0, y: 1.5, z: 0.0}}" --once